{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/device/**",
              "components/icons/**",
              "components/rainbow/**",
              "icons/**",
              "ui_kits/device/**",
              "ui_kits/device/apps/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Press Start 2P|VT323))/i]",
        "message": "Font not provided by the design system. Available: Press Start 2P, VT323."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|footer|children|animate|phase|statusLabel|clock|link|background|backdrop|footerColor|key|ref|className|style|children)$/]",
        "message": "<AppFrame> doesn't accept that prop. Declared props: title, footer, children, animate, phase, statusLabel, clock, link, background, backdrop, footerColor."
      },
      {
        "selector": "JSXOpeningElement[name.name='BootScene'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|tagline|duration|finale|loop|scale|onDone|style|key|ref|className|style|children)$/]",
        "message": "<BootScene> doesn't accept that prop. Declared props: title, tagline, duration, finale, loop, scale, onDone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeviceScreen'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|scale|bezel|label|style|key|ref|className|style|children)$/]",
        "message": "<DeviceScreen> doesn't accept that prop. Declared props: children, scale, bezel, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuScreen'] > JSXAttribute > JSXIdentifier[name!=/^(?:app|index|count|onPrev|onNext|onSelect|status|clock|animate|key|ref|className|style|children)$/]",
        "message": "<MenuScreen> doesn't accept that prop. Declared props: app, index, count, onPrev, onNext, onSelect, status, clock, animate."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<OptionItem> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='PixelIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|cell|animate|frame|tick|background|title|style|key|ref|className|style|children)$/]",
        "message": "<PixelIcon> doesn't accept that prop. Declared props: name, cell, animate, frame, tick, background, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RainbowBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|width|height|phase|animate|label|showPercent|style|key|ref|className|style|children)$/]",
        "message": "<RainbowBar> doesn't accept that prop. Declared props: value, width, height, phase, animate, label, showPercent, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RainbowFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|thickness|phase|animate|radius|padding|style|key|ref|className|style|children)$/]",
        "message": "<RainbowFrame> doesn't accept that prop. Declared props: children, thickness, phase, animate, radius, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RainbowText'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|phase|size|animate|as|style|key|ref|className|style|children)$/]",
        "message": "<RainbowText> doesn't accept that prop. Declared props: children, phase, size, animate, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RainbowText'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:span|div|h1|h2|h3|p)$/]",
        "message": "<RainbowText> as must be one of 'span' | 'div' | 'h1' | 'h2' | 'h3' | 'p'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScreenText'] > JSXAttribute > JSXIdentifier[name!=/^(?:x|y|size|color|align|width|bg|children|style|key|ref|className|style|children)$/]",
        "message": "<ScreenText> doesn't accept that prop. Declared props: x, y, size, color, align, width, bg, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScreenText'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<ScreenText> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='UnicornSprite'] > JSXAttribute > JSXIdentifier[name!=/^(?:cell|animate|frame|style|key|ref|className|style|children)$/]",
        "message": "<UnicornSprite> doesn't accept that prop. Declared props: cell, animate, frame, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
