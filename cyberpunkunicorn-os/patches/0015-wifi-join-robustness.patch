+// CyberUnicorn: on this no-PSRAM board the Bluetooth remote (BLE API) holds the DMA
+// block Wi-Fi needs. Turn it off rather than refusing Wi-Fi; the Remote app shows it off.
+static bool makeRoomForWifi() {
+    if (radioHasMemForWifi()) return true;
+#if !defined(LITE_VERSION)
+    if (isBLEAPIEnabled()) {
+        Serial.println("[WiFi] Low DMA memory: turning the Bluetooth remote off for Wi-Fi");
+        enableBLEAPI(); // toggles it off
+        vTaskDelay(300 / portTICK_PERIOD_MS);
+    }
+#endif
+    if (!radioHasMemForWifi()) {
+        stopBLEStack();
+        vTaskDelay(300 / portTICK_PERIOD_MS);
+    }
+    return radioHasMemForWifi();
+}
+
+// CyberUnicorn: why a join failed, in words, instead of a bare "Wifi Offline".
+static String wifiFailReason() {
+    switch (WiFi.status()) {
+        case WL_NO_SSID_AVAIL: return "Network not found";
+        case WL_CONNECT_FAILED: return "Wrong password?";
+        case WL_CONNECTION_LOST: return "Connection lost";
+        case WL_DISCONNECTED: return "No answer (password or DHCP)";
+        default: return "Wifi Offline";
+    }
+}
