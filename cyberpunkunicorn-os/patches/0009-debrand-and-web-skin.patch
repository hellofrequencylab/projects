diff --git a/embedded_resources/web_interface/index.css b/embedded_resources/web_interface/index.css
index bda7b42..0b5b27d 100644
--- a/embedded_resources/web_interface/index.css
+++ b/embedded_resources/web_interface/index.css
@@ -582,3 +582,64 @@ svg > path {
     width: 64px;
   }
 }
+
+/* ===== CyberUnicorn 5000 skin ===================================== */
+:root {
+  --color: #ff3ec8;
+  --cyan: #00f0ff;
+  --background: #0b0016;
+  --rainbow: linear-gradient(90deg, #ff004c, #ff8a00, #ffe600, #00ff85, #00d4ff, #7a5cff, #ff3ec8, #ff004c);
+}
+@keyframes cu-slide { from { background-position: 0% 50%; } to { background-position: 400% 50%; } }
+@keyframes cu-glow { 0%, 100% { text-shadow: 0 0 6px #ff3ec8, 0 0 14px #ff3ec8; } 50% { text-shadow: 0 0 6px #00f0ff, 0 0 14px #00f0ff; } }
+body {
+  background:
+    linear-gradient(transparent 0 calc(100% - 1px), rgba(0, 240, 255, 0.12) 0) 0 0 / 100% 32px,
+    linear-gradient(90deg, transparent 0 calc(100% - 1px), rgba(255, 62, 200, 0.12) 0) 0 0 / 32px 100%,
+    radial-gradient(ellipse at top, #3a0060 0%, #0b0016 60%);
+  background-attachment: fixed;
+}
+.container .header {
+  border-bottom: 3px solid transparent;
+  border-image: var(--rainbow) 1;
+}
+.container .header .title {
+  background: var(--rainbow);
+  background-size: 400% 100%;
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+  animation: cu-slide 6s linear infinite;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+.container .header .title * { color: var(--cyan); -webkit-text-fill-color: var(--cyan); }
+.btn-action {
+  border: 1px solid transparent;
+  border-image: var(--rainbow) 1;
+  box-shadow: 0 0 8px rgba(255, 62, 200, 0.35);
+  transition: box-shadow 0.15s, transform 0.15s;
+}
+.btn-action:hover {
+  box-shadow: 0 0 14px #00f0ff, 0 0 4px #ff3ec8 inset;
+  transform: translateY(-1px);
+  animation: cu-glow 1.2s ease-in-out infinite;
+}
+.dialog {
+  border: 2px solid transparent;
+  border-image: var(--rainbow) 1;
+  background-color: #12001f;
+  box-shadow: 0 0 24px rgba(122, 92, 255, 0.5);
+}
+.dialog .dialog-head { background: var(--rainbow); background-size: 400% 100%; animation: cu-slide 8s linear infinite; }
+.dialog .dialog-head span { color: #0b0016; font-weight: bold; }
+input, textarea, select {
+  background-color: #12001f;
+  border: 1px solid var(--cyan);
+  color: var(--cyan);
+}
+a { color: var(--cyan); text-shadow: 0 0 6px var(--cyan); }
+::selection { background: #ff3ec8; color: #0b0016; }
+::-webkit-scrollbar { width: 8px; height: 8px; }
+::-webkit-scrollbar-thumb { background: var(--rainbow); border-radius: 4px; }
+::-webkit-scrollbar-track { background: #12001f; }
